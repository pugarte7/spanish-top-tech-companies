{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-label.py\"",
            "timeout": 10,
            "statusMessage": "Checking release label"
          }
        ]
      }
    ]
  }
}
